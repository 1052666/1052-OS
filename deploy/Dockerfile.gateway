# 1052-OS Industrial Gateway — Dockerfile
# Python 3.12 + FastAPI + Modbus/OPC UA/MQTT/TDengine

FROM python:3.12-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*

# Python deps
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv && \
    uv sync --frozen --no-dev && \
    pip uninstall -y uv

# App code
COPY gateway/ ./gateway/

# Config from env vars
ENV TD_HOST=tdengine
ENV TD_PORT=6041
ENV TD_USER=root
ENV TD_PASS=taosdata
ENV TD_DB=industrial

EXPOSE 8765

CMD ["python", "-m", "uvicorn", "gateway.server:app", "--host", "0.0.0.0", "--port", "8765"]
