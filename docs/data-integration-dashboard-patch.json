  {
    "id": "di_dash_chart_fn",
    "type": "function",
    "z": "data_integration_tab",
    "name": "提取参数趋势",
    "func": "const out=[];\nfor (const rec of (msg.payload.recent_param || []).slice(-2)) {\n  for (const item of rec.items || []) {\n    const v = Number(item.monitor_value);\n    if (!Number.isNaN(v)) out.push({topic:item.detectorno, payload:v});\n  }\n}\nreturn [out];",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 800,
    "wires": [
      [
        "di_dash_chart"
      ]
    ]
  },
