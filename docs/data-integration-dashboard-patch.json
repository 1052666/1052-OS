  {
    "id": "di_dash_join",
    "type": "function",
    "z": "data_integration_tab",
    "name": "组合 Dashboard 数据",
    "func": "const s = flow.get('di_dashboard_state') || {mock:{}, flow:{}};\nif (msg.req || msg.payload?.recent_raw || Object.prototype.hasOwnProperty.call(msg.payload || {}, 'alarm_count')) s.mock = msg.payload || {};\nelse s.flow = msg.payload || {};\nflow.set('di_dashboard_state', s);\nmsg.payload = s;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 690,
    "wires": [
      [
        "di_dash_tpl"
      ]
    ]
  },
  {
    "id": "di_dash_tpl",
    "type": "ui-template",
    "z": "data_integration_tab",
    "group": "1052_dbg_g_interface",
    "page": "",
    "ui": "",
    "name": "数据对接 Dashboard 联调控件",
    "order": 0,
    "width": 12,
    "height": 10,
    "head": "",
    "format": "\n<template>\n  <div>\n    <h2 style=\"margin:0 0 8px;color:#e2e8f0\">数据对接接口 Dashboard 联调</h2>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin:8px 0 12px\">\n      <button style=\"border:0;border-radius:10px;padding:13px 16px;background:#16a34a;color:white;font-weight:800\" @click=\"send({payload:'di_alarm_manual_normal'})\">推送正常 flag=0</button>\n      <button style=\"border:0;border-radius:10px;padding:13px 16px;background:#dc2626;color:white;font-weight:800\" @click=\"send({payload:'di_alarm_active'})\">推送报警 flag=1</button>\n      <button style=\"border:0;border-radius:10px;padding:13px 16px;background:#0284c7;color:white;font-weight:800\" @click=\"send({payload:'di_param_manual'})\">推送实时参数</button>\n    </div>\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px\">\n      <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:10px\"><div style=\"color:#94a3b8\">报警接口调用</div><div style=\"font-size:26px;font-weight:800;color:#22c55e\">{{ msg.payload.mock.alarm_count || 0 }}</div></div>\n      <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:10px\"><div style=\"color:#94a3b8\">参数接口调用</div><div style=\"font-size:26px;font-weight:800;color:#38bdf8\">{{ msg.payload.mock.param_count || 0 }}</div></div>\n      <div style=\"background:#0f172a;border:1px solid #334155;border-radius:8px;padding:10px\"><div style=\"color:#94a3b8\">flow计数</div><div style=\"font-size:26px;font-weight:800;color:#f59e0b\">{{ msg.payload.flow.counters?.alarm || 0 }}/{{ msg.payload.flow.counters?.param || 0 }}</div></div>\n    </div>\n    <h3>最近报警/参数</h3>\n    <pre style=\"max-height:320px;overflow:auto;background:#020617;color:#cbd5e1;padding:10px;border-radius:8px\">{{ JSON.stringify(msg.payload.mock.recent_raw || [], null, 2) }}</pre>\n  </div>\n</template>\n",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 980,
    "y": 690,
    "wires": [
      [
        "di_dash_trigger"
      ]
    ]
  },
  {
    "id": "di_dash_trigger",
    "type": "function",
    "z": "data_integration_tab",
    "name": "Dashboard按钮→inject",
    "func": "msg.method = 'POST';\nmsg.url = 'http://127.0.0.1:1880/inject/' + String(msg.payload);\nmsg.payload = '';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1240,
    "y": 690,
    "wires": [
      [
        "di_dash_http"
      ]
    ]
  },
  {
    "id": "di_dash_http",
