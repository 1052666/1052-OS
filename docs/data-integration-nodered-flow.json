  {
    "id": "di_make_alarm",
    "type": "function",
    "z": "data_integration_tab",
    "name": "生成报警信息数组",
    "func": "const qyid = flow.get('di_qyid');\nconst flag = String(msg.payload || '0');\nconst now = new Date(Date.now() + 8 * 3600 * 1000).toISOString().replace('T',' ').slice(0,19);\nconst normal = flag === '0';\nconst base = [\n  {tankno:'BX10', detectorno:'A253010', riskname:'一号重大危险源'},\n  {tankno:'BX10', detectorno:'P253011', riskname:'一号重大危险源'},\n  {tankno:'LGYLK-01', detectorno:'LGBJQ-03/04', riskname:'二号重大危险源'}\n];\nmsg.payload = base.map((x, i) => {\n  const item = {qyid, tankno:x.tankno, detectorno:x.detectorno, riskname:x.riskname, flag};\n  if (!normal) {\n    item.starttime = now;\n    item.grade = i === 0 ? '04' : '03';\n    item.monitor_value = i === 0 ? '96.8' : (i === 1 ? '1.25' : '28.4');\n  }\n  return item;\n});\nmsg.url = (flow.get('di_baseUrl') || 'http://127.0.0.1:5904/web_service/ws/cz_alarm') + '/putMonitorData';\nmsg.headers = {'Content-Type':'application/json'};\nflow.set('di_alarmCount', (flow.get('di_alarmCount') || 0) + 1);\nnode.status({fill:normal?'green':'red',shape:'dot',text:(normal?'正常':'报警')+' '+msg.payload.length+'点'});\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 220,
    "wires": [
      [
        "di_http",
        "di_debug_req"
      ]
    ]
  },
