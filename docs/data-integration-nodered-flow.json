  {
    "id": "di_make_param",
    "type": "function",
    "z": "data_integration_tab",
    "name": "生成实时参数数组",
    "func": "const qyid = flow.get('di_qyid');\nconst count = (flow.get('di_paramCount') || 0) + 1;\nflow.set('di_paramCount', count);\nmsg.payload = [\n  {qyid, tankno:'BX10', detectorno:'A253010', monitor_value:(20 + Math.sin(count/3)*3).toFixed(2)},\n  {qyid, tankno:'BX10', detectorno:'P253011', monitor_value:(0.85 + Math.random()*0.1).toFixed(2)},\n  {qyid, tankno:'LGYLK-01', detectorno:'LGBJQ-03/04', monitor_value:(18 + Math.random()*4).toFixed(2)}\n];\nmsg.url = (flow.get('di_baseUrl') || 'http://127.0.0.1:5904/web_service/ws/cz_alarm') + '/putMonitorParamData';\nmsg.headers = {'Content-Type':'application/json'};\nnode.status({fill:'blue',shape:'dot',text:'参数 '+msg.payload.length+'点'});\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 380,
