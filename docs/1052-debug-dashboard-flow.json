  {
    "id": "1052_dbg_interface_card",
    "type": "function",
    "z": "1052_dbg_tab",
    "name": "接口联调状态数据",
    "func": "\nconst status = msg.payload.raw || {};\nconst flowState = flow.get('debug_di_flow_state') || {};\nconst recentAlarm = [];\nfor (const rec of (status.recent_alarm || []).slice(-5).reverse()) {\n  for (const [i, item] of (rec.items || []).entries()) {\n    recentAlarm.push({key: rec.time + ':a:' + i, time: rec.time, ...item});\n  }\n}\nconst recentParam = [];\nfor (const rec of (status.recent_param || []).slice(-5).reverse()) {\n  for (const [i, item] of (rec.items || []).entries()) {\n    recentParam.push({key: rec.time + ':p:' + i, time: rec.time, ...item});\n  }\n}\nmsg.payload = {\n  status,\n  flow: flowState,\n  endpoints: [\n    '/web_service/ws/cz_alarm/putMonitorData',\n    '/web_service/ws/cz_alarm/putMonitorParamData',\n    '/api/data-integration/status'\n  ],\n  recentAlarm: recentAlarm.slice(0, 12),\n  recentParam: recentParam.slice(0, 12)\n};\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 910,
    "y": 780,
    "wires": [
      [
        "1052_dbg_interface_tpl"
      ]
    ]
  },
  {
    "id": "1052_dbg_interface_tpl",
    "type": "ui-template",
    "z": "1052_dbg_tab",
    "group": "1052_dbg_g_interface",
    "page": "",
    "ui": "",
    "name": "接口联调状态页",
    "order": 0,
    "width": 12,
    "height": 10,
    "head": "",
    "format": "\n<template>\n  <div>\n    <h2 style=\"margin:0 0 8px;color:#e2e8f0\">数据对接接口联调控制台</h2>\n    <div class=\"di-actions\">\n      <button class=\"dibtn ok\" @click=\"send({payload:'di_alarm_manual_normal'})\">推送正常状态 flag=0</button>\n      <button class=\"dibtn alarm\" @click=\"send({payload:'di_alarm_active'})\">推送报警状态 flag=1</button>\n      <button class=\"dibtn param\" @click=\"send({payload:'di_param_manual'})\">推送实时参数</button>\n    </div>\n    <div class=\"kpi-grid\">\n      <div class=\"kpi ok\"><div class=\"label\">报警接口调用</div><div class=\"value\">{{ msg.payload.status.alarm_count || 0 }}</div><div class=\"small\">/putMonitorData</div></div>\n      <div class=\"kpi\"><div class=\"label\">参数接口调用</div><div class=\"value\">{{ msg.payload.status.param_count || 0 }}</div><div class=\"small\">/putMonitorParamData</div></div>\n      <div class=\"kpi\"><div class=\"label\">Node-RED 计数</div><div class=\"value\">{{ msg.payload.flow.counters?.alarm || 0 }}/{{ msg.payload.flow.counters?.param || 0 }}</div><div class=\"small\">flow context</div></div>\n    </div>\n    <p><span v-for=\"e in msg.payload.endpoints\" class=\"badge\" :key=\"e\">{{ e }}</span></p>\n    <h3>最近报警数据</h3>\n    <table class=\"di-table\"><thead><tr><th>时间</th><th>tankno</th><th>detectorno</th><th>flag</th><th>grade</th><th>monitor_value</th></tr></thead>\n      <tbody><tr v-for=\"row in msg.payload.recentAlarm\" :key=\"row.key\"><td>{{ row.time }}</td><td>{{ row.tankno }}</td><td>{{ row.detectorno }}</td><td>{{ row.flag }}</td><td>{{ row.grade }}</td><td>{{ row.monitor_value }}</td></tr></tbody></table>\n    <h3>最近实时参数</h3>\n    <table class=\"di-table\"><thead><tr><th>时间</th><th>tankno</th><th>detectorno</th><th>monitor_value</th></tr></thead>\n      <tbody><tr v-for=\"row in msg.payload.recentParam\" :key=\"row.key\"><td>{{ row.time }}</td><td>{{ row.tankno }}</td><td>{{ row.detectorno }}</td><td>{{ row.monitor_value }}</td></tr></tbody></table>\n    <pre class=\"mon\">{{ JSON.stringify(msg.payload.status, null, 2) }}</pre>\n  </div>\n</template>\n",
