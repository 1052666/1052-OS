  {
    "id": "1052_dbg_style",
    "type": "ui-template",
    "z": "1052_dbg_tab",
    "group": "",
    "page": "",
    "ui": "1052_dbg_ui",
    "name": "Dashboard 工业暗色样式",
    "order": 0,
    "width": 0,
    "height": 0,
    "head": "",
    "format": "\n<style>\n.nrdb-ui-widget, .v-card { font-family: ui-monospace, Menlo, Consolas, monospace; }\n.kpi-grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(150px,1fr)); gap:10px; }\n.kpi { background:#0f172a; border:1px solid #334155; border-radius:8px; padding:10px; }\n.kpi .label { color:#94a3b8; font-size:12px; }\n.kpi .value { color:#e2e8f0; font-size:24px; font-weight:700; }\n.kpi.ok .value { color:#22c55e; } .kpi.warn .value { color:#f59e0b; } .kpi.bad .value { color:#ef4444; }\npre.mon { max-height:300px; overflow:auto; background:#020617; color:#cbd5e1; padding:10px; border-radius:8px; border:1px solid #1e293b; }\n.badge { display:inline-block; padding:2px 8px; border-radius:999px; background:#1e293b; color:#93c5fd; margin-right:6px; }\n.imgbox img { max-width:100%; border-radius:8px; border:1px solid #334155; background:#020617; }\n.small { color:#94a3b8; font-size:12px; }\n\n.sim-actions { display:grid; grid-template-columns: repeat(auto-fit,minmax(180px,1fr)); gap:10px; margin:8px 0 12px; }\n.simbtn { border:0; border-radius:10px; padding:14px 16px; color:white; font-weight:800; font-size:15px; cursor:pointer; box-shadow:0 6px 14px rgba(0,0,0,.25); }\n.simbtn:hover { filter:brightness(1.15); transform:translateY(-1px); }\n.simbtn.blue { background:#0284c7; } .simbtn.green { background:#16a34a; } .simbtn.purple { background:#7c3aed; } .simbtn.orange { background:#ea580c; } .simbtn.red { background:#dc2626; }\n\n.di-actions { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px; margin:8px 0 12px; }\n.dibtn { border:0; border-radius:10px; padding:13px 16px; color:white; font-weight:800; cursor:pointer; box-shadow:0 6px 14px rgba(0,0,0,.25); }\n.dibtn:hover { filter:brightness(1.12); transform:translateY(-1px); }\n.dibtn.ok { background:#16a34a; } .dibtn.alarm { background:#dc2626; } .dibtn.param { background:#0284c7; }\n.di-table { width:100%; border-collapse:collapse; font-size:12px; }\n.di-table th, .di-table td { border-bottom:1px solid #334155; padding:6px 8px; text-align:left; }\n.di-table th { color:#93c5fd; }\n</style>\n",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "site:style",
    "className": "",
    "x": 180,
    "y": 60,
    "wires": [
      []
    ]
