{
  "name": "1052-os-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src --pool=forks",
    "test:watch": "vitest src --pool=forks",
    "test:audit": "node scripts/frontend-replacement-audit.mjs",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-wide --project=chromium-mobile",
    "test:e2e:desktop": "playwright test --project=chromium-desktop",
    "test:e2e:wide": "playwright test --project=chromium-wide",
    "test:e2e:mobile": "playwright test --project=chromium-mobile",
    "test:e2e:webkit": "playwright test --project=webkit-desktop",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:interactions": "node scripts/interaction-smoke.mjs",
    "test:live-backend": "node scripts/live-backend-smoke.mjs",
    "test:production": "npm run build && node scripts/production-smoke.mjs",
    "docs:screenshots": "node scripts/readme-screenshots.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-sql": "^6.8.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.8",
    "@tanstack/react-table": "^8.20.6",
    "@tanstack/react-virtual": "^3.11.2",
    "@types/qrcode": "^1.5.6",
    "@uiw/react-codemirror": "^4.23.7",
    "@xyflow/react": "^12.10.2",
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.14.0",
    "motion": "^12.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
